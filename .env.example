# Copy this file to .env and fill in your own values.
# Get credentials at: https://console.cloud.google.com/apis/credentials
# See docs/memory/features/gdrive-oauth-setup-notes.md for step-by-step setup.
# MapKit JS: see docs/mapkit-js-setup.md (never commit the .p8 key).

GDRIVE_CLIENT_ID="123456789-abcdef.apps.googleusercontent.com"
GDRIVE_CLIENT_SECRET="GOCSPX-your-client-secret-here"
GOOGLE_FONTS_API_KEY="xxx"

# MapKit (read docs/mapkit-js-setup.md)
MEMLORE_MAPKIT_TOKEN=xxx
MAPKIT_KEY_ID="xxx"
MAPKIT_TEAM_ID="xxx"

