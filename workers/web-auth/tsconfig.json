{
  "compilerOptions": {
    "target": "esnext",
    // Deliberately no "DOM": @cloudflare/workers-types redeclares Request/Response/
    // Headers, and the default lib would make every one of them a duplicate.
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
