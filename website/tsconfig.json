{
  "compilerOptions": {
    "tsBuildInfoFile": "./.cache/tsconfig.website.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@tauri-apps/api/core": ["./demo/mocks/core.ts"],
      "@tauri-apps/api/event": ["../mockup/mocks/event.ts"],
      "@tauri-apps/api/window": ["../mockup/mocks/window.ts"],
      "@tauri-apps/api/path": ["../mockup/mocks/path.ts"],
      "@tauri-apps/plugin-opener": ["./demo/mocks/plugin-opener.ts"],
      "@tauri-apps/plugin-dialog": ["../mockup/mocks/plugin-dialog.ts"],
      "@tauri-apps/plugin-notification": ["../mockup/mocks/plugin-notification.ts"]
    }
  },
  "include": ["../src", "../mockup/mocks", "../mockup/scenarios", "."],
  "exclude": [
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "../src/test/**",
    "../mockup/**/*.test.ts",
    "../mockup/**/*.test.tsx",
    "dist"
  ]
}
