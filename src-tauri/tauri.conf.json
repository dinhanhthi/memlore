{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memlore",
  "version": "0.2.0",
  "identifier": "app.memlore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Memlore",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'unsafe-eval' https://cdn.apple-mapkit.com",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:* ws://localhost:* https://*.apple-mapkit.com https: wss:",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob: https://*.apple-mapkit.com https:",
        "font-src": "'self' asset: http://asset.localhost https://asset.localhost data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**", "$APPDATA/fonts/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.release.plist",
      "minimumSystemVersion": "13.0",
      "files": {
        "embedded.provisionprofile": "../.ci/memlore.provisionprofile"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QzNENDk5MUM3N0RCNkUKUldSdTIzY2NtZFREUkJ6eVdzeE9CcjJvWTBYaTRPZmh4ekZFUmdnQXJiVDZIUDJUQzhoNU0zSTAK",
      "endpoints": ["https://github.com/dinhanhthi/memlore/releases/latest/download/latest.json"]
    }
  }
}
